# Environment Configuration
# Local Postgres via: npm run db:up  (docker compose)
DATABASE_URL="postgresql://denard:denard@localhost:55432/denard?schema=public"

# Public site URL — production domain is denard.co.uk (used in WhatsApp / SEO / payment redirects)
# Local development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (set on host):
# NEXT_PUBLIC_SITE_URL="https://denard.co.uk"
NEXT_PUBLIC_SITE_NAME="Denard"

# WhatsApp business number (E.164 digits only, no + / spaces)
# Also editable in Admin → Settings (whatsapp_phone)
NEXT_PUBLIC_WHATSAPP_NUMBER="447887539426"
WHATSAPP_PHONE="447887539426"
NEXT_PUBLIC_WHATSAPP_PHONE="447887539426"

# Auth — REQUIRED in production: random string, min 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"

# Seeded owner account (change password immediately after first login)
ADMIN_DEFAULT_EMAIL="admin@denard.co.uk"
ADMIN_DEFAULT_PASSWORD="DenardAdmin2026!"

# Locale
NEXT_PUBLIC_DEFAULT_CURRENCY="GBP"
NEXT_PUBLIC_DEFAULT_LOCALE="en-GB"

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Durable media (S3 / Cloudflare R2 / MinIO). If unset, uploads use local public/uploads (dev only).
# S3_BUCKET="denard-media"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://media.denard.co.uk"
# For bare R2 pub-*.r2.dev hosts, include the bucket in the path:
# S3_PUBLIC_BASE_URL="https://pub-<id>.r2.dev/denard-media"

# Optional staff email alerts on new enquiries (Resend)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Denard <hello@denard.co.uk>"
# ENQUIRY_NOTIFY_EMAIL="hello@denard.co.uk"

# Optional Cloudflare Turnstile on public forms
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Webhook endpoint: https://denard.co.uk/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired
